{
  "name": "academy-management",
  "version": "1.0.0",
  "description": "A comprehensive sports academy management system for the Indian market",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "db:migrate": "node database/run-migrations.js",
    "db:seed": "node database/seeds/001_seed_admin.js",
    "dev:full": "concurrently \"npm run dev\" \"cd client && npm start\"",
    "setup": "node setup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "keywords": ["academy", "management", "sports", "students", "fitness", "india"],
  "author": "",
  "license": "MIT"
}
